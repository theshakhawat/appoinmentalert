{
  "manifest_version": 3,
  "name": "Appointment Alert",
  "version": "1.0",
  "description": "Appointment alert extension",

  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],

  "action": {
    "default_popup": "popup.html"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["audio/appointment-alert.mp3"],
      "matches": ["<all_urls>"]
    }
  ]
}